---
import PostList from '../../components/PostList.astro';
import Base from '../../layouts/Base.astro';
import { getPosts, monthLabel } from '../../utils';

const posts = await getPosts();

// Group by month, newest first (posts are already sorted).
const groups: { label: string; posts: typeof posts }[] = [];
for (const post of posts) {
	const label = monthLabel(post.data.pubDate);
	const last = groups[groups.length - 1];
	if (last && last.label === label) last.posts.push(post);
	else groups.push({ label, posts: [post] });
}

const allTags = [...new Set(posts.flatMap((p) => p.data.tags.map((t) => t.toLowerCase())))].sort();
---

<Base title="Posts" description="Every post on this blog, newest first.">
	<h1>Posts</h1>
	<p class="muted intro">{posts.length} {posts.length === 1 ? 'post' : 'posts'}, newest first.</p>

	<!-- Search and tag filters only work with JavaScript, so they stay hidden without it -->
	<fieldset class="group find" data-controls hidden>
		<legend>Find</legend>
		<div class="row">
			<label for="q">Search:</label>
			<input id="q" class="field" type="search" autocomplete="off" />
		</div>
		{
			allTags.length > 0 && (
				<div class="chips" role="group" aria-label="Filter by tag">
					<button type="button" class="chip btn is-pressed" data-tag="" aria-pressed="true">
						All
					</button>
					{allTags.map((t) => (
						<button type="button" class="chip btn" data-tag={t} aria-pressed="false">
							{t}
						</button>
					))}
				</div>
			)
		}
		<p class="status" id="status" aria-live="polite"></p>
	</fieldset>

	<p class="empty" id="empty" hidden>No posts match your search.</p>

	{
		groups.map((g) => (
			<section class="month">
				<h2>{g.label}</h2>
				<PostList posts={g.posts} />
			</section>
		))
	}
</Base>

<script>
	const controls = document.querySelector<HTMLElement>('[data-controls]');
	const input = document.querySelector<HTMLInputElement>('#q');
	const status = document.querySelector<HTMLElement>('#status');
	const empty = document.querySelector<HTMLElement>('#empty');
	const chips = [...document.querySelectorAll<HTMLButtonElement>('.chip')];
	const items = [...document.querySelectorAll<HTMLElement>('.post-item')];
	const months = [...document.querySelectorAll<HTMLElement>('.month')];

	if (controls && input && status && empty) {
		controls.hidden = false;
		let tag = '';

		const apply = () => {
			const q = input.value.trim().toLowerCase();
			let shown = 0;
			for (const li of items) {
				const matchesText = !q || (li.dataset.search ?? '').includes(q);
				const matchesTag = !tag || (li.dataset.tags ?? '').split(',').includes(tag);
				li.hidden = !(matchesText && matchesTag);
				if (!li.hidden) shown++;
			}
			for (const m of months) m.hidden = !m.querySelector('.post-item:not([hidden])');
			empty.hidden = shown > 0;
			const filtering = q !== '' || tag !== '';
			status.textContent = filtering ? `${shown} of ${items.length} shown` : '';
		};

		input.addEventListener('input', apply);
		for (const chip of chips) {
			chip.addEventListener('click', () => {
				tag = chip.dataset.tag ?? '';
				for (const c of chips) {
					const on = c === chip;
					c.classList.toggle('is-pressed', on);
					c.setAttribute('aria-pressed', String(on));
				}
				apply();
			});
		}
	}
</script>

<style>
	.intro {
		margin-bottom: 24px;
	}
	.find {
		display: flex;
		flex-direction: column;
		gap: 14px;
		margin-bottom: 36px;
		padding: 12px 16px 14px;
	}
	.find legend {
		padding: 0 6px;
		font-size: 14px;
	}
	.find[hidden] {
		display: none;
	}
	.row {
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 14px;
	}
	input {
		flex: 1;
		min-width: 0;
		font-size: 16px;
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	.chip {
		min-width: 0;
		padding: 4px 14px;
		font-size: 13px;
	}
	.chip.is-pressed {
		padding: 5px 13px 3px 15px;
	}
	.status:empty {
		display: none;
	}
	.status {
		margin: 0;
		font-size: 13px;
		color: var(--muted);
	}
	.empty {
		margin: 0 0 36px;
		padding: 10px 14px;
		background: var(--note);
		border: 1px solid #000;
	}
	.month {
		margin-bottom: 36px;
	}
	.month h2 {
		margin-top: 0;
		margin-bottom: 14px;
	}
</style>
