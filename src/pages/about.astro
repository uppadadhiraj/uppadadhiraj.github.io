---
import Base from '../layouts/Base.astro';
import { AUTHOR, GITHUB_URL } from '../consts';
---

<Base title="About" description={`Who is ${AUTHOR}?`}>
	<h1>About</h1>
	<div class="prose">
		<p>
			Hi, I'm {AUTHOR}. I'm a 4th-year BTech student learning Python, Java and JavaScript, and I
			like building things that probably shouldn't run on the hardware I give them.
		</p>
		<p>
			This blog is where I write up what I'm learning: build logs, bug hunts, and short notes like
			"how to find the length of an array".
		</p>
		<p>Find me on <a href={GITHUB_URL}>GitHub</a>.</p>
	</div>
</Base>
