---
import Base from '../layouts/Base.astro';
import { AUTHOR, GITHUB_URL } from '../consts';

// Edit these lines to describe yourself.
const facts = [
	['Name', AUTHOR],
	['Role', 'BTech student'],
	['Learning', 'Java'],
	['Also uses', 'Python, JavaScript'],
];
---

<Base title="About" description={`Who is ${AUTHOR}?`}>
	<h1>About</h1>

	<div class="prose">
		<p>Hi, I'm {AUTHOR}. I'm learning to code, and I write down what I learn as I go.</p>
		<p>
			This blog is my progress log: short notes, small programs and the bugs I ran into. If
			something clicked for me today, it goes here so I can find it again later.
		</p>
		<p>Find me on <a href={GITHUB_URL}>GitHub</a>.</p>
	</div>

	<section class="dialog props">
		<div class="dlg-title">{AUTHOR} Properties</div>
		<div class="dlg-body">
			<div class="tabs" aria-hidden="true"><span>General</span></div>
			<div class="sheet group">
				<dl>
					{
						facts.map(([label, value]) => (
							<div class="row">
								<dt>{label}:</dt>
								<dd>{value}</dd>
							</div>
						))
					}
				</dl>
			</div>
		</div>
	</section>
</Base>

<style>
	.props {
		max-width: 460px;
		margin-top: 32px;
	}
	.dlg-body {
		padding: 16px 16px 20px;
	}
	.tabs {
		display: flex;
		margin-bottom: -1px;
		position: relative;
		z-index: 1;
	}
	.tabs span {
		padding: 4px 16px 5px;
		font-size: 14px;
		background: var(--face);
		box-shadow: inset 1px 1px 0 var(--hi), inset -1px 0 0 var(--dark), inset -2px 0 0 var(--shadow);
	}
	.sheet {
		padding: 18px 16px;
		background: var(--face);
		border: 0;
		box-shadow: inset -1px -1px 0 var(--dark), inset 1px 1px 0 var(--hi),
			inset -2px -2px 0 var(--shadow), inset 2px 2px 0 var(--light);
	}
	dl {
		margin: 0;
		display: grid;
		gap: 10px;
		font-size: 14.5px;
	}
	.row {
		display: grid;
		grid-template-columns: 9ch minmax(0, 1fr);
		gap: 4px 12px;
	}
	dt {
		color: var(--muted);
	}
	dd {
		margin: 0;
		font-weight: 700;
	}
</style>
