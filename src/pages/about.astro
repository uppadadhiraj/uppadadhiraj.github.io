---
import Base from '../layouts/Base.astro';
import { AUTHOR, GITHUB_URL } from '../consts';

// Edit these lines to describe yourself.
const facts = [
	['Name', AUTHOR],
	['Role', 'BTech student'],
	['Learning', 'Java'],
	['Also uses', 'Python, JavaScript'],
];
---

<Base title="About" description={`Who is ${AUTHOR}?`}>
	<h1>About</h1>

	<section class="card px">
		<div class="prose">
			<p>Hi, I'm {AUTHOR}. I'm learning to code, and I write down what I learn as I go.</p>
			<p>
				This blog is my progress log: short notes, small programs and the bugs I ran into. If
				something clicked for me today, it goes here so I can find it again later.
			</p>
		</div>

		<dl>
			{
				facts.map(([label, value]) => (
					<div class="row">
						<dt>{label}</dt>
						<dd>{value}</dd>
					</div>
				))
			}
		</dl>

		<p class="find">Find me on <a href={GITHUB_URL}>GitHub</a>.</p>
	</section>
</Base>

<style>
	.card {
		padding: 28px 32px;
	}
	dl {
		margin: 24px 0 24px;
		padding: 18px 0;
		display: grid;
		gap: 12px;
		background:
			repeating-linear-gradient(90deg, var(--line-dim) 0 8px, transparent 8px 16px) top / 100% 4px no-repeat,
			repeating-linear-gradient(90deg, var(--line-dim) 0 8px, transparent 8px 16px) bottom / 100% 4px no-repeat;
	}
	.row {
		display: grid;
		grid-template-columns: 11ch minmax(0, 1fr);
		gap: 6px 16px;
		align-items: baseline;
	}
	dt {
		font-family: var(--pixel);
		font-size: 0.6rem;
		text-transform: uppercase;
		color: var(--yellow);
	}
	dd {
		margin: 0;
	}
	.find {
		margin: 0;
	}
	@media (max-width: 640px) {
		.card {
			padding: 22px 18px;
		}
		.row {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
