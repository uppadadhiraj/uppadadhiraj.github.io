---
import Base from '../layouts/Base.astro';
import { link } from '../utils';
---

<Base title="404" description="Page not found.">
	<section class="dialog error">
		<div class="dlg-title">Error</div>
		<div class="dlg-body">
			<span class="icon" aria-hidden="true">&times;</span>
			<div>
				<h1>Page not found</h1>
				<p>That page doesn't exist, or it moved somewhere else.</p>
			</div>
		</div>
		<p class="buttons">
			<a class="btn is-default" href={link('/')}>OK</a>
			<a class="btn" href={link('/blog/')}>All posts</a>
		</p>
	</section>
</Base>

<style>
	.error {
		max-width: 480px;
		margin: 24px auto 0;
	}
	.dlg-body {
		display: flex;
		gap: 18px;
		align-items: flex-start;
		padding: 22px 22px 12px;
	}
	.icon {
		flex-shrink: 0;
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		font-size: 30px;
		font-weight: 700;
		line-height: 1;
		color: #fff;
		background: #c00000;
		border-radius: 50%;
		box-shadow: inset -2px -2px 0 #800000, inset 2px 2px 0 #ff6060;
	}
	h1 {
		margin: 0 0 8px;
		font-size: 1.3rem;
		color: #000;
	}
	.dlg-body p {
		margin: 0;
	}
	.buttons {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 12px;
		margin: 0;
		padding: 8px 16px 18px;
	}
</style>
