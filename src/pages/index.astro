---
import PostList from '../components/PostList.astro';
import Sprite from '../components/Sprite.astro';
import Base from '../layouts/Base.astro';
import { AUTHOR, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { MONITOR } from '../sprites';
import { getPosts, isoDate, link } from '../utils';

const posts = await getPosts();
const latest = posts.slice(0, 5);
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="dialog welcome">
		<div class="dlg-title">Welcome</div>
		<div class="dlg-body">
			<Sprite art={MONITOR} size={5} class="art" />
			<div class="text">
				<h1>Hi, I'm {AUTHOR}!</h1>
				<p class="lead">{SITE_DESCRIPTION}</p>
				{
					posts[0] && (
						<p class="stats muted">
							{posts.length} {posts.length === 1 ? 'post' : 'posts'} &middot; last updated{' '}
							{isoDate(posts[0].data.pubDate)}
						</p>
					)
				}
				<p class="actions">
					<a class="btn is-default" href={link('/blog/')}>Read posts</a>
					<a class="btn" href={link('/about/')}>About me</a>
				</p>
			</div>
		</div>
	</section>

	<h2>Latest posts</h2>
	<PostList posts={latest} markNewest />
	{
		posts.length > latest.length && (
			<p class="more">
				<a class="btn" href={link('/blog/')}>All {posts.length} posts</a>
			</p>
		)
	}
</Base>

<style>
	.welcome {
		margin-bottom: 40px;
	}
	.dlg-body {
		display: flex;
		gap: 28px;
		align-items: center;
		padding: 24px 28px;
	}
	.dlg-body :global(.art) {
		flex-shrink: 0;
		color: #000080;
	}
	h1 {
		margin-bottom: 10px;
	}
	.lead {
		font-size: 1.1rem;
		margin-bottom: 6px;
	}
	.stats {
		margin-bottom: 20px;
		font-size: 0.9rem;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin: 0;
	}
	h2 {
		margin-top: 0;
		margin-bottom: 16px;
	}
	.more {
		margin: 24px 0 0;
	}

	@media (max-width: 640px) {
		.dlg-body {
			flex-direction: column;
			align-items: flex-start;
			gap: 16px;
			padding: 18px 16px;
		}
		.dlg-body :global(.art) {
			width: 52px;
			height: 44px;
		}
	}
</style>
