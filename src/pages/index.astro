---
import PostList from '../components/PostList.astro';
import Sprite from '../components/Sprite.astro';
import Base from '../layouts/Base.astro';
import { AUTHOR, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { MONITOR } from '../sprites';
import { getPosts, isoDate, link } from '../utils';

const posts = await getPosts();
const latest = posts.slice(0, 5);
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="hero px">
		<Sprite art={MONITOR} size={8} class="art" />
		<div class="text">
			<h1>Hi, I'm {AUTHOR}!</h1>
			<p class="lead">{SITE_DESCRIPTION}</p>
			{
				posts[0] && (
					<p class="stats">
						{posts.length} {posts.length === 1 ? 'post' : 'posts'} &middot; last updated{' '}
						{isoDate(posts[0].data.pubDate)}
					</p>
				)
			}
			<p class="actions">
				<a class="btn is-primary" href={link('/blog/')}>Read posts</a>
				<a class="btn" href={link('/about/')}>About me</a>
			</p>
		</div>
	</section>

	<h2>Latest posts</h2>
	<PostList posts={latest} markNewest />
	{
		posts.length > latest.length && (
			<p class="more">
				<a class="btn" href={link('/blog/')}>All {posts.length} posts</a>
			</p>
		)
	}
</Base>

<style>
	.hero {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 36px;
		align-items: center;
		padding: 32px 36px;
		margin-bottom: 44px;
	}
	.hero :global(.art) {
		color: var(--cyan);
	}
	h1 {
		margin-bottom: 14px;
	}
	.lead {
		font-size: 1.5rem;
		color: var(--muted);
		margin-bottom: 8px;
	}
	.stats {
		margin-bottom: 24px;
		color: var(--muted);
		font-size: 1.15rem;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 18px;
		margin: 0;
	}
	h2 {
		margin-top: 0;
	}
	.more {
		margin: 32px 0 0;
	}

	@media (max-width: 720px) {
		.hero {
			grid-template-columns: minmax(0, 1fr);
			padding: 24px 20px;
			gap: 22px;
			justify-items: start;
		}
		.hero :global(.art) {
			width: 78px;
			height: 66px;
		}
	}
</style>
