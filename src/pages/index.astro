---
import PostList from '../components/PostList.astro';
import Base from '../layouts/Base.astro';
import { AUTHOR, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getPosts, link } from '../utils';

const posts = await getPosts();
const latest = posts.slice(0, 5);
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="intro">
		<h1>Hi, I'm {AUTHOR} 👋</h1>
		<p class="muted">{SITE_DESCRIPTION}</p>
	</section>

	<h2>Latest posts</h2>
	<PostList posts={latest} />
	{
		posts.length > latest.length && (
			<p class="more">
				<a href={link('/blog/')}>See all {posts.length} posts →</a>
			</p>
		)
	}
</Base>

<style>
	.intro {
		padding: 16px 0 8px;
	}
	.intro p {
		font-size: 1.15rem;
	}
	h2 {
		margin-top: 1.2em;
	}
	.more {
		margin-top: 20px;
	}
</style>
