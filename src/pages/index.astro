---
import PostList from '../components/PostList.astro';
import Sprite from '../components/Sprite.astro';
import Base from '../layouts/Base.astro';
import { AUTHOR, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { HEART, INVADER } from '../sprites';
import { getPosts, isoDate, link } from '../utils';

const posts = await getPosts();
const latest = posts.slice(0, 5);

// Every 10 posts = 1 level.
const level = Math.floor(posts.length / 10) + 1;
const xp = posts.length % 10;
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="hero px">
		<div class="art" aria-hidden="true">
			<Sprite art={INVADER} size={8} class="invader" />
			<span class="lives">
				<Sprite art={HEART} size={3} />
				<Sprite art={HEART} size={3} />
				<Sprite art={HEART} size={3} />
			</span>
		</div>
		<div class="text">
			<p class="kicker">PLAYER 1 READY<span class="blink">_</span></p>
			<h1>Hi, I'm {AUTHOR}!</h1>
			<p class="lead">{SITE_DESCRIPTION}</p>
			<p class="actions">
				<a class="btn is-primary" href={link('/blog/')}>Read posts</a>
				<a class="btn" href={link('/about/')}>About me</a>
			</p>
		</div>
	</section>

	<ul class="hud">
		<li class="px">
			<span class="k">Posts</span>
			<span class="v">{String(posts.length).padStart(3, '0')}</span>
		</li>
		<li class="px">
			<span class="k">Last update</span>
			<span class="v">{posts[0] ? isoDate(posts[0].data.pubDate) : '---'}</span>
		</li>
		<li class="px">
			<span class="k">Level {String(level).padStart(2, '0')}</span>
			<span class="xp" role="img" aria-label={`${xp} of 10 posts to the next level`}>
				{Array.from({ length: 10 }, (_, i) => <span class:list={['cell', { on: i < xp }]} />)}
			</span>
		</li>
	</ul>

	<h2>Latest posts</h2>
	<PostList posts={latest} markNewest />
	{
		posts.length > latest.length && (
			<p class="more">
				<a class="btn" href={link('/blog/')}>All {posts.length} posts</a>
			</p>
		)
	}
</Base>

<style>
	.hero {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 32px;
		align-items: center;
		padding: 32px;
		margin-bottom: 36px;
	}
	.art {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 18px;
		padding: 0 8px;
	}
	.art :global(.invader) {
		color: var(--green);
		animation: bob 1s steps(1) infinite;
	}
	.lives {
		display: flex;
		gap: 6px;
		color: var(--pink);
	}
	@keyframes bob {
		50% {
			transform: translateY(8px);
		}
	}
	.kicker {
		margin: 0 0 16px;
		font-family: var(--pixel);
		font-size: 0.6rem;
		color: var(--pink);
	}
	h1 {
		margin-bottom: 14px;
	}
	.lead {
		font-size: 1.5rem;
		color: var(--muted);
		margin-bottom: 22px;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 18px;
		margin: 0;
	}

	.hud {
		list-style: none;
		margin: 0 0 40px;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 24px;
	}
	.hud li {
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: 14px 16px;
	}
	.k {
		font-family: var(--pixel);
		font-size: 0.55rem;
		text-transform: uppercase;
		color: var(--muted);
	}
	.v {
		font-family: var(--pixel);
		font-size: 0.95rem;
		color: var(--yellow);
	}
	.xp {
		display: flex;
		gap: 3px;
		height: 20px;
	}
	.cell {
		flex: 1;
		background: var(--ink);
	}
	.cell.on {
		background: var(--green);
	}

	h2 {
		margin-top: 0;
	}
	.more {
		margin: 32px 0 0;
	}

	@media (max-width: 720px) {
		.hero {
			grid-template-columns: minmax(0, 1fr);
			padding: 24px 20px;
			gap: 24px;
			justify-items: start;
		}
		.art {
			flex-direction: row;
			padding: 0;
			gap: 20px;
		}
		.art :global(.invader) {
			width: 66px;
			height: 48px;
		}
		.hud {
			grid-template-columns: minmax(0, 1fr);
			gap: 20px;
		}
		.hud li {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
		}
		.xp {
			width: 140px;
		}
	}
</style>
