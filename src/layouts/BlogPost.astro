---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import { isoDate, link, readMinutes } from '../utils';

type Post = CollectionEntry<'blog'>;
interface Props {
	post: Post;
	newer?: Post;
	older?: Post;
}

const { post, newer, older } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, tags, draft } = post.data;
---

<Base title={title} description={description} image={heroImage}>
	<article>
		<header class="post-head">
			<h1>{title}{draft && <span class="muted"> (draft)</span>}</h1>
			<p class="meta muted">
				<time datetime={pubDate.toISOString()}>{isoDate(pubDate)}</time>
				{
					updatedDate && (
						<span>
							updated <time datetime={updatedDate.toISOString()}>{isoDate(updatedDate)}</time>
						</span>
					)
				}
				<span>{readMinutes(post.body)} min read</span>
			</p>
			{
				tags.length > 0 && (
					<p class="tags">
						{tags.map((t) => (
							<span class="tag">{t}</span>
						))}
					</p>
				)
			}
		</header>

		{
			heroImage && (
				<div class="hero-img">
					<Image width={1020} height={510} src={heroImage} alt="" />
				</div>
			)
		}

		<div class="prose">
			<slot />
		</div>
	</article>

	<nav class="post-nav" aria-label="More posts">
		<a class="btn all" href={link('/blog/')}>&lt; All posts</a>
		{
			older && (
				<a class="btn older" href={link(`/blog/${older.id}/`)}>
					<span class="dir">&lt; Older</span>
					<span class="t">{older.data.title}</span>
				</a>
			)
		}
		{
			newer && (
				<a class="btn newer" href={link(`/blog/${newer.id}/`)}>
					<span class="dir">Newer &gt;</span>
					<span class="t">{newer.data.title}</span>
				</a>
			)
		}
	</nav>
</Base>

<script>
	// Give every code block a title bar with its language and a copy button.
	document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
		const lang = pre.querySelector('code')?.className.match(/language-(\S+)/)?.[1] ?? 'code';

		const bar = document.createElement('div');
		bar.className = 'codebar';
		const label = document.createElement('span');
		label.textContent = lang;
		const button = document.createElement('button');
		button.type = 'button';
		button.className = 'copy';
		button.textContent = 'Copy';
		bar.append(label, button);

		const wrap = document.createElement('div');
		wrap.className = 'codeblock';
		pre.replaceWith(wrap);
		wrap.append(bar, pre);

		button.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(pre.textContent ?? '');
				button.textContent = 'Copied!';
			} catch {
				button.textContent = 'Failed';
			}
			setTimeout(() => (button.textContent = 'Copy'), 1500);
		});
	});
</script>

<style>
	.post-head {
		padding-bottom: 16px;
		margin-bottom: 24px;
		border-bottom: 1px solid var(--shadow);
		box-shadow: 0 1px 0 var(--hi);
	}
	.post-head h1 {
		margin-bottom: 10px;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 2px 18px;
		margin: 0 0 10px;
		font-size: 0.92rem;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 0;
	}
	.post-nav {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 44px;
		padding-top: 20px;
		border-top: 1px solid var(--shadow);
		box-shadow: 0 -1px 0 var(--hi);
	}
	.post-nav .btn {
		text-align: left;
	}
	.older,
	.newer {
		display: flex;
		flex-direction: column;
		gap: 4px;
		max-width: 100%;
		min-width: 0;
	}
	.newer {
		margin-left: auto;
		text-align: right;
	}
	.dir {
		font-size: 12px;
		color: var(--muted);
	}
	.t {
		font-weight: 700;
		overflow-wrap: anywhere;
	}
	@media (max-width: 640px) {
		.newer {
			margin-left: 0;
			text-align: left;
		}
		.post-nav .btn {
			flex: 1 1 100%;
		}
	}
</style>
