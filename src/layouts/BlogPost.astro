---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import { isoDate, link, readMinutes } from '../utils';

type Post = CollectionEntry<'blog'>;
interface Props {
	post: Post;
	newer?: Post;
	older?: Post;
}

const { post, newer, older } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, draft } = post.data;
---

<Base title={title} description={description} image={heroImage}>
	<article>
		<header class="post-head">
			<h1>{title}{draft && <span class="muted"> (draft)</span>}</h1>
			<p class="meta muted">
				<time datetime={pubDate.toISOString()}>{isoDate(pubDate)}</time>
				{
					updatedDate && (
						<>
							{' '}· updated <time datetime={updatedDate.toISOString()}>{isoDate(updatedDate)}</time>
						</>
					)
				}
				{' '}· {readMinutes(post.body)} min read
			</p>
		</header>

		{
			heroImage && (
				<div class="hero">
					<Image width={1020} height={510} src={heroImage} alt="" />
				</div>
			)
		}

		<div class="prose">
			<slot />
		</div>
	</article>

	<nav class="post-nav" aria-label="More posts">
		{older && <a href={link(`/blog/${older.id}/`)}>← {older.data.title}</a>}
		{newer && <a class="right" href={link(`/blog/${newer.id}/`)}>{newer.data.title} →</a>}
		<a class="all" href={link('/blog/')}>All posts</a>
	</nav>
</Base>

<style>
	.post-head {
		padding-bottom: 16px;
		margin-bottom: 24px;
		border-bottom: 1px solid var(--border);
	}
	.post-head h1 {
		margin-bottom: 6px;
	}
	.meta {
		margin: 0;
		font-size: 0.95rem;
	}
	.post-nav {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 24px;
		margin-top: 48px;
		padding-top: 16px;
		border-top: 1px solid var(--border);
	}
	.right {
		margin-left: auto;
	}
	.all {
		flex-basis: 100%;
		color: var(--muted);
	}
</style>
