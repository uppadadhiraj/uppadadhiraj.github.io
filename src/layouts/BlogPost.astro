---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import { PROMPT } from '../consts';
import { fileSize, isoDate, link, readMinutes } from '../utils';

type Post = CollectionEntry<'blog'>;
interface Props {
	post: Post;
	newer?: Post;
	older?: Post;
}

const { post, newer, older } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, draft } = post.data;
---

<Base title={title} description={description} image={heroImage}>
	<p class="line">
		<span class="prompt">{PROMPT}</span> <span class="cmd">cat posts/{post.id}.md</span>
	</p>

	<article>
		<header class="post-head">
			<h1>{title}{draft && <span class="dim"> [DRAFT]</span>}</h1>
			<p class="meta dim">
				<time datetime={pubDate.toISOString()}>{isoDate(pubDate)}</time>
				{
					updatedDate && (
						<>
							{' '}| UPDATED <time datetime={updatedDate.toISOString()}>{isoDate(updatedDate)}</time>
						</>
					)
				}
				{' '}| {readMinutes(post.body)} MIN READ | {fileSize(post.body)}
			</p>
		</header>

		{
			heroImage && (
				<div class="hero">
					<Image width={1020} height={510} src={heroImage} alt="" />
				</div>
			)
		}

		<div class="prose">
			<slot />
		</div>

		<p class="eof dim">-- EOF --</p>
	</article>

	<nav class="post-nav" aria-label="More posts">
		{older && <a href={link(`/blog/${older.id}/`)}>&lt; OLDER: {older.data.title}</a>}
		{newer && <a href={link(`/blog/${newer.id}/`)}>NEWER: {newer.data.title} &gt;</a>}
		<a href={link('/blog/')}>[ cd ../posts ]</a>
	</nav>
</Base>

<style>
	.post-head {
		margin: 18px 0 8px;
		padding-bottom: 10px;
		border-bottom: 1px dashed var(--ph-dim);
	}
	.post-head h1 {
		margin: 0 0 6px;
	}
	.meta {
		margin: 0;
	}
	.eof {
		margin-top: 2em;
		text-align: center;
	}
	.post-nav {
		display: flex;
		flex-direction: column;
		gap: 6px;
		padding-top: 12px;
		border-top: 1px dashed var(--ph-dim);
	}
	.post-nav a {
		align-self: flex-start;
	}
</style>
