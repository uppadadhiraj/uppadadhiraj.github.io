---
import { SITE_TITLE } from '../consts';
import { link } from '../utils';

const path = Astro.url.pathname;
const home = link('/');
const items = [
	{ label: 'Home', href: home, active: path === home || path === `${home}index.html` },
	{ label: 'Posts', href: link('/blog/'), active: path.startsWith(link('/blog')) },
	{ label: 'About', href: link('/about/'), active: path.startsWith(link('/about')) },
];
---

<header>
	<a class="site-title" href={home}>{SITE_TITLE}</a>
	<nav aria-label="Main">
		{
			items.map((item) => (
				<a
					href={item.href}
					class:list={['nav-link', { active: item.active }]}
					aria-current={item.active ? 'page' : undefined}
				>
					{item.label}
				</a>
			))
		}
	</nav>
</header>

<style>
	header {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 8px 24px;
		padding: 24px 0;
		border-bottom: 1px solid var(--border);
	}
	.site-title {
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--text);
		text-decoration: none;
	}
	nav {
		display: flex;
		gap: 4px;
	}
	.nav-link {
		color: var(--muted);
		text-decoration: none;
		padding: 4px 12px;
		border-radius: 999px;
	}
	.nav-link:hover {
		color: var(--text);
	}
	.nav-link.active {
		background: var(--accent-soft);
		color: var(--accent);
		font-weight: 600;
	}
</style>
