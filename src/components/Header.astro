---
import Sprite from './Sprite.astro';
import { SITE_TITLE } from '../consts';
import { MONITOR } from '../sprites';
import { link } from '../utils';

const path = Astro.url.pathname;
const home = link('/');
const items = [
	{ label: 'Home', href: home, active: path === home || path === `${home}index.html` },
	{ label: 'Posts', href: link('/blog/'), active: path.startsWith(link('/blog')) },
	{ label: 'About', href: link('/about/'), active: path.startsWith(link('/about')) },
];
---

<header>
	<a class="brand" href={home} aria-label={`${SITE_TITLE}, home`}>
		<Sprite art={MONITOR} size={3} class="brand-sprite" />
		<span>{SITE_TITLE}</span>
	</a>
	<nav aria-label="Main">
		{
			items.map((item) => (
				<a
					href={item.href}
					class:list={['btn', { 'is-current': item.active }]}
					aria-current={item.active ? 'page' : undefined}
				>
					{item.label}
				</a>
			))
		}
	</nav>
</header>

<style>
	header {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 20px 24px;
		padding: 32px 0 28px;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 14px;
		font-family: var(--pixel);
		font-size: clamp(0.8rem, 3.6vw, 1rem);
		color: var(--yellow);
		text-decoration: none;
	}
	.brand :global(.brand-sprite) {
		color: var(--cyan);
		flex-shrink: 0;
	}
	.brand:hover {
		color: var(--cyan);
	}
	.brand:hover :global(.brand-sprite) {
		color: var(--yellow);
	}
	nav {
		display: flex;
		gap: 14px;
	}
	@media (max-width: 520px) {
		nav {
			width: 100%;
		}
		nav .btn {
			flex: 1;
			text-align: center;
			padding-inline: 6px;
		}
	}
</style>
