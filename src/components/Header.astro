---
import { SITE_TITLE } from '../consts';
import { link } from '../utils';

const path = Astro.url.pathname;
const home = link('/');
const items = [
	{ label: 'Home', href: home, active: path === home || path === `${home}index.html` },
	{ label: 'Posts', href: link('/blog/'), active: path.startsWith(link('/blog')) },
	{ label: 'About', href: link('/about/'), active: path.startsWith(link('/about')) },
];
---

<header>
	<div class="titlebar">
		<a class="site-title" href={home}>{SITE_TITLE}</a>
		<span class="wbtns" aria-hidden="true"><i>_</i><i>□</i><i>×</i></span>
	</div>
	<nav aria-label="Main">
		{
			items.map((item) => (
				<a
					href={item.href}
					class:list={['nav-link', { active: item.active }]}
					aria-current={item.active ? 'page' : undefined}
				>
					{item.label}
				</a>
			))
		}
	</nav>
</header>

<style>
	.titlebar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		padding: 3px 4px 3px 8px;
		background: linear-gradient(90deg, #000080, #1084d0);
	}
	.site-title {
		color: #fff;
		font-weight: 700;
		font-size: 1rem;
		text-decoration: none;
		letter-spacing: 0.04em;
	}
	.site-title:visited,
	.site-title:hover {
		color: #fff;
	}
	.wbtns {
		display: flex;
		gap: 2px;
	}
	.wbtns i {
		width: 18px;
		height: 16px;
		display: grid;
		place-items: center;
		font: 700 12px/1 var(--font);
		font-style: normal;
		color: #000;
		background: var(--face);
		box-shadow: var(--raised);
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		padding: 6px 2px;
	}
	.nav-link {
		padding: 3px 18px;
		color: #000;
		text-decoration: none;
		background: var(--face);
		box-shadow: var(--raised);
	}
	.nav-link:visited,
	.nav-link:hover {
		color: #000;
	}
	.nav-link:active,
	.nav-link.active {
		box-shadow: var(--sunken);
		font-weight: 700;
	}
</style>
