---
import { AUTHOR, GITHUB_URL } from '../consts';
import { link } from '../utils';

const year = new Date().getFullYear();
---

<footer>
	<span class="cell">© {year} {AUTHOR}</span>
	<span class="cell links">
		<a href={GITHUB_URL}>GitHub</a>
		<a href={link('/rss.xml')}>RSS</a>
	</span>
</footer>

<style>
	footer {
		display: flex;
		gap: 4px;
		font-size: 0.85rem;
	}
	.cell {
		padding: 2px 10px;
		box-shadow: var(--sunken);
	}
	.cell:first-child {
		flex: 1;
	}
	.links {
		display: flex;
		gap: 14px;
	}
	.links a {
		color: #000;
	}
	.links a:hover {
		color: #f00;
	}
</style>
