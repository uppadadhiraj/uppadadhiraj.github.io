---
import { AUTHOR, GITHUB_URL } from '../consts';
import { link } from '../utils';

const year = new Date().getFullYear();
---

<footer>
	<span>© {year} {AUTHOR}</span>
	<span class="links">
		<a href={GITHUB_URL}>GitHub</a>
		<a href={link('/rss.xml')}>RSS</a>
	</span>
</footer>

<style>
	footer {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 8px 16px;
		padding: 24px 0 32px;
		border-top: 1px solid var(--border);
		color: var(--muted);
		font-size: 0.9rem;
	}
	.links {
		display: flex;
		gap: 16px;
	}
	.links a {
		color: var(--muted);
	}
	.links a:hover {
		color: var(--accent);
	}
</style>
