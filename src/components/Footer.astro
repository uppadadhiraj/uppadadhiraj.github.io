---
import { AUTHOR, GITHUB_URL } from '../consts';
import { link } from '../utils';

const year = new Date().getFullYear();
---

<footer class="statusbar">
	<span class="cell grow">Done</span>
	<span class="cell">&copy; {year} {AUTHOR}</span>
	<span class="cell links">
		<a href={GITHUB_URL}>GitHub</a>
		<a href={link('/rss.xml')}>RSS</a>
	</span>
</footer>

<style>
	.statusbar {
		display: flex;
		gap: 3px;
		font-size: 13px;
		line-height: 1.4;
	}
	.cell {
		padding: 2px 10px;
		box-shadow: inset 1px 1px 0 var(--shadow), inset -1px -1px 0 var(--hi);
	}
	.grow {
		flex: 1;
	}
	.links {
		display: flex;
		gap: 14px;
	}
	.links a,
	.links a:visited {
		color: #000;
	}
	.links a:hover {
		color: #e00000;
	}
	@media (max-width: 640px) {
		.grow {
			display: none;
		}
		.cell:first-of-type + .cell {
			flex: 1;
		}
	}
</style>
