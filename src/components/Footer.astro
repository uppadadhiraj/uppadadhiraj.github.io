---
import { AUTHOR, GITHUB_URL } from '../consts';
import { link } from '../utils';

const year = new Date().getFullYear();
---

<footer>
	<p class="copy-line">&copy; {year} {AUTHOR}</p>
	<p class="links">
		<a href={GITHUB_URL}>GitHub</a>
		<a href={link('/rss.xml')}>RSS</a>
		<a href="#top">Top</a>
	</p>
</footer>

<style>
	footer {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 12px 24px;
		padding: 28px 0 36px;
		background: repeating-linear-gradient(90deg, var(--line-dim) 0 8px, transparent 8px 16px) top / 100% 4px
			no-repeat;
		color: var(--muted);
	}
	p {
		margin: 0;
	}
	.links {
		display: flex;
		gap: 20px;
		font-family: var(--pixel);
		font-size: 0.6rem;
		text-transform: uppercase;
	}
	.links a {
		color: var(--muted);
		text-decoration: none;
	}
	.links a:hover {
		color: var(--yellow);
	}
</style>
