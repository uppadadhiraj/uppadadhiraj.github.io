---
import type { CollectionEntry } from 'astro:content';
import { isoDate, link } from '../utils';

interface Props {
	posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

{
	posts.length === 0 ? (
		<p class="muted">No posts yet.</p>
	) : (
		<ul class="posts">
			{posts.map((post, i) => (
				<li>
					<a class="card" href={link(`/blog/${post.id}/`)}>
						<span class="ico" aria-hidden="true">📄</span>
						<span class="body">
							<time datetime={post.data.pubDate.toISOString()}>{isoDate(post.data.pubDate)}</time>
							<strong>
								{post.data.title}
								{post.data.draft && <span class="draft">DRAFT</span>}
								{i === 0 && <span class="new blink">NEW!</span>}
							</strong>
							<span class="desc">{post.data.description}</span>
						</span>
					</a>
				</li>
			))}
		</ul>
	)
}

<style>
	.posts {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 12px;
	}
	.card {
		display: flex;
		gap: 14px;
		align-items: flex-start;
		padding: 12px 16px;
		background: var(--face);
		box-shadow: var(--raised);
		color: #000;
		text-decoration: none;
	}
	.card:visited {
		color: #000;
	}
	.card:hover {
		background: var(--accent-soft);
	}
	.card:hover strong {
		color: var(--accent);
		text-decoration: underline;
	}
	.card:active {
		box-shadow: var(--sunken);
	}
	.ico {
		font-size: 1.6rem;
		line-height: 1.2;
	}
	.body {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}
	time {
		font-size: 0.8rem;
		color: var(--muted);
	}
	strong {
		font-size: 1.1rem;
	}
	.desc {
		color: var(--muted);
	}
	.new {
		margin-left: 8px;
		font-family: var(--pixel);
		font-size: 0.6rem;
		color: #f00;
		vertical-align: middle;
	}
	.draft {
		margin-left: 8px;
		padding: 0 6px;
		font-size: 0.7rem;
		background: #000080;
		color: #fff;
		vertical-align: middle;
	}
</style>
