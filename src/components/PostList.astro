---
import type { CollectionEntry } from 'astro:content';
import { isoDate, link } from '../utils';

interface Props {
	posts: CollectionEntry<'blog'>[];
	/** Show a NEW badge on the first post (used on the home page). */
	markNewest?: boolean;
}

const { posts, markNewest = false } = Astro.props;
---

<ul class="files field">
	{
		posts.map((post, i) => {
			const { title, description, tags, draft, pubDate } = post.data;
			return (
				<li
					class="post-item"
					data-search={`${title} ${description} ${tags.join(' ')}`.toLowerCase()}
					data-tags={tags.map((t) => t.toLowerCase()).join(',')}
				>
					<a class="file" href={link(`/blog/${post.id}/`)}>
						<svg
							class="doc"
							width="24"
							height="28"
							viewBox="0 0 12 14"
							shape-rendering="crispEdges"
							aria-hidden="true"
						>
							<path d="M.5.5h7l4 4v9h-11z" fill="#fff" stroke="#000" />
							<path d="M7.5.5v4h4" fill="none" stroke="#000" />
							<path d="M2 6.5h7M2 8.5h7M2 10.5h5" stroke="#000080" />
						</svg>
						<span class="info">
							<span class="title">
								{title}
								{draft && <span class="badge">Draft</span>}
								{markNewest && i === 0 && <span class="badge new">New</span>}
							</span>
							<span class="desc">{description}</span>
							{tags.length > 0 && (
								<span class="tags">
									{tags.map((t) => (
										<span class="tag">{t}</span>
									))}
								</span>
							)}
						</span>
						<time class="date" datetime={pubDate.toISOString()}>
							{isoDate(pubDate)}
						</time>
					</a>
				</li>
			);
		})
	}
</ul>

<style>
	.files {
		list-style: none;
		margin: 0;
		padding: 4px;
	}
	.post-item + .post-item {
		border-top: 1px dotted #b0b0b0;
	}
	.file {
		display: grid;
		grid-template-columns: 24px minmax(0, 1fr) auto;
		gap: 4px 14px;
		align-items: start;
		padding: 10px 12px;
		color: #000;
		text-decoration: none;
	}
	.file:visited {
		color: #000;
	}
	.doc {
		margin-top: 2px;
	}
	.info {
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
	}
	.title {
		font-size: 1.1rem;
		font-weight: 700;
		line-height: 1.3;
		overflow-wrap: anywhere;
	}
	.desc {
		color: var(--muted);
		font-size: 0.95rem;
		overflow-wrap: anywhere;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin-top: 4px;
	}
	.date {
		padding-top: 3px;
		font-size: 0.9rem;
		color: var(--muted);
		white-space: nowrap;
		font-variant-numeric: tabular-nums;
	}
	.badge {
		display: inline-block;
		margin-left: 6px;
		padding: 0 6px;
		font-size: 11px;
		font-weight: 700;
		line-height: 1.5;
		vertical-align: middle;
		color: #fff;
		background: var(--shadow);
	}
	.badge.new {
		background: #c00000;
	}

	.file:hover,
	.file:focus-visible {
		color: #fff;
		background: var(--navy);
		outline: none;
	}
	.file:hover .desc,
	.file:hover .date,
	.file:focus-visible .desc,
	.file:focus-visible .date {
		color: #d8d8ff;
	}

	@media (max-width: 520px) {
		.file {
			grid-template-columns: 24px minmax(0, 1fr);
			padding: 10px 8px;
		}
		.date {
			grid-column: 2;
			grid-row: 2;
			padding-top: 0;
			font-size: 0.85rem;
		}
		.info {
			grid-row: 1;
			grid-column: 2;
		}
		.doc {
			grid-row: 1;
		}
	}
</style>
